{
    "name": "gateloop",
    "version": "0.0.0",
    "description": "GateLoop 门控闭环引擎：AI Agent 的运行时——流程门控、多 skill 协作、exit code 验证（nut CLI + 编程 API）",
    "type": "module",
    "main": "./dist/gateloop/index.cjs",
    "module": "./dist/gateloop/index.mjs",
    "types": "./dist/gateloop/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/gateloop/index.mjs",
            "require": "./dist/gateloop/index.cjs",
            "types": "./dist/gateloop/index.d.ts"
        },
        "./engine": {
            "import": "./dist/gateloop/index.mjs",
            "require": "./dist/gateloop/index.cjs",
            "types": "./dist/gateloop/index.d.ts"
        },
        "./helpers": {
            "import": "./dist/helpers/index.mjs",
            "require": "./dist/helpers/index.cjs",
            "types": "./dist/helpers/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "bin": {
        "nut": "./dist/cli/index.cjs"
    },
    "scripts": {
        "dev": "cross-env NODE_ENV=development rollup -c rollup.config.ts --watch --bundleConfigAsCjs --configPlugin typescript",
        "build": "cross-env NODE_ENV=production rollup -c rollup.config.ts --bundleConfigAsCjs --configPlugin typescript",
        "clean": "rimraf dist",
        "demo": "node demo/index.cjs",
        "guard": "node dist/cli/index.cjs gateloop init anchor.config.json --task \"引擎代码质量守护\" && node dist/cli/index.cjs gateloop next anchor.config.json",
        "guard:status": "node dist/cli/index.cjs gateloop status anchor.config.json",
        "guard:retry": "node dist/cli/index.cjs gateloop retry anchor.config.json",
        "guard:reset": "node dist/cli/index.cjs gateloop reset anchor.config.json"
    },
    "dependencies": {
        "@rollup/pluginutils": "^5.1.0",
        "chokidar": "^3.5.3",
        "commander": "^12.1.0",
        "cross-spawn": "7.0.6",
        "eslint": "^8.56.0",
        "fs-extra": "^11.3.2",
        "glob": "^10.3.3",
        "iconv-lite": "^0.6.3",
        "prettier": "^3.1.1",
        "rimraf": "^5.0.5",
        "semver": "^7.6.2"
    },
    "devDependencies": {
        "@babel/core": "^7.24.3",
        "@babel/preset-env": "^7.24.3",
        "@babel/preset-typescript": "^7.24.1",
        "@rollup/plugin-alias": "^5.1.0",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.5",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^11.1.6",
        "@types/cross-spawn": "^6.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.10.6",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "cross-env": "10.1.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "prettier": "^3.1.1",
        "rollup": "^4.53.3",
        "rollup-plugin-delete": "^2.1.0",
        "rollup-plugin-dts": "^6.1.0",
        "ts-jest": "^29.4.5",
        "tslib": "2.8.1",
        "tsx": "4.21.0",
        "typescript": "^5.4.2"
    },
    "keywords": [
        "cli",
        "gateloop",
        "ai-agent",
        "harness",
        "code-execution",
        "format",
        "lint",
        "knowledge-base",
        "cross-platform",
        "tools",
        "automation",
        "ai-tools"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": ""
    }
}
