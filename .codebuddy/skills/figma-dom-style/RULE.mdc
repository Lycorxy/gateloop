### 算法伪代码：布局决策优先级

```
function applyLayout(node, layoutPlan, annotation) {
  // 1. 标注最优先
  if (annotation?.role) applyAnnotationRole(node, annotation);
  if (annotation?.sizeMode) applyAnnotationSize(node, annotation);
  if (annotation?.overflow) applyAnnotationOverflow(node, annotation);

  // 2. layout-plan 次之
  const decision = layoutPlan.layoutDecisions.find(d => d.nodeId === node.id);
  if (decision && decision.confidence >= 0.7) {
    applyOptimizedLayout(node, decision);
    return;
  }

  // 3. 原始测量值兜底
  applyAbsolutePosition(node, node.bounds);
}
```

### 算法伪代码：CSS 技巧检测

```
function detectCssTrick(node, parent, siblings) {
  // 居中检测
  const offsetX = Math.abs(node.x - (parent.width - node.width) / 2);
  const offsetY = Math.abs(node.y - (parent.height - node.height) / 2);
  if (offsetX < 3 && offsetY < 3) return { type: 'center-both', technique: 'flex-center' };
  if (offsetX < 3) return { type: 'center-h', technique: 'margin-auto' };
  if (offsetY < 3) return { type: 'center-v', technique: 'flex-align-center' };

  // 等间距检测
  const gaps = computeGaps(siblings);
  if (gaps.variance < 4) return { type: 'equal-gap', technique: 'parent-gap', value: gaps.mean };

  // 撑满检测
  const padding = computeParentPadding(parent);
  if (Math.abs(node.width - (parent.width - padding.left - padding.right)) < 3) {
    return { type: 'full-width', technique: 'width-auto' };
  }

  // 贴底/贴顶
  if (Math.abs(node.y + node.height - parent.height) < 3) {
    return { type: 'stick-bottom', technique: 'margin-top-auto' };
  }

  return { type: 'absolute', technique: 'keep-absolute' };
}
```

