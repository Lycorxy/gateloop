{
  "name": "example-skill",
  "description": "示例：ADS Harness 模式 Skill 配置模板（含子任务/数据管道/熔断/临时区）",
  "stateFile": ".specflow/anchor-state.json",
  "logFile": ".specflow/anchor-log.jsonl",
  "scratchDir": ".specflow/scratch",
  "scratchGcHours": 72,
  "maxAttempts": 5,
  "anchors": [
    {
      "id": "design",
      "name": "设计阶段",
      "brief": "产出 frontend-plan.json，包含组件拆分、路由设计、数据流方案。\n约束：必须基于现有代码分析，禁止凭空设计。完成后 emit artifact 'frontendPlan' 供下游消费。",
      "reads": [".codebuddy/skills/frontend-design/references/architecture.md"],
      "produces": ["frontend-plan.json"],
      "emits": ["frontendPlan"],
      "allowedTools": ["read_file", "search_content", "code-explorer"],
      "verify": {
        "schema": {
          "type": "object",
          "required": ["components", "routes", "dataFlow"],
          "properties": {
            "components": { "type": "array" },
            "routes": { "type": "array" },
            "dataFlow": { "type": "object" }
          }
        },
        "producesExist": true,
        "producesFresh": true
      },
      "subagentPrompt": "使用 code-explorer 探索项目结构，产出 frontend-plan.json"
    },
    {
      "id": "code",
      "name": "编码阶段",
      "brief": "按上游 frontendPlan 生成代码。\n大任务先用 subtask-add 拆成每页/每组件一个子任务，逐个完成 subtask-done，全绿才可推进。\n约束：文件 ≤ 360 行，禁止 any，遵循项目 lint 规则。",
      "reads": [".codebuddy/skills/frontend-codegen/RULE.mdc"],
      "consumes": ["frontendPlan"],
      "produces": ["src/**/*.tsx", "src/**/*.ts"],
      "requiresSubtasks": true,
      "maxAttempts": 8,
      "allowedTools": ["read_file", "write_file", "replace_in_file", "search_content"],
      "verify": {
        "lintFix": true,
        "lint": true,
        "tsc": true,
        "stylelint": true,
        "producesExist": true,
        "producesFresh": true
      }
    },
    {
      "id": "test",
      "name": "测试阶段",
      "brief": "为生成的代码补充单元测试，确保测试通过。",
      "produces": ["src/**/*.test.ts", "src/**/*.spec.ts"],
      "allowedTools": ["read_file", "write_file", "execute_command"],
      "verify": {
        "test": { "command": "npx vitest run" },
        "producesExist": true
      }
    }
  ]
}
