{
    "name": "ai-ultra",
    "version": "0.0.0-beta.0",
    "description": "🚀 ai-ultra - 为模型提供统一的命令行工具集（代码执行、格式化、Lint 知识库生成）",
    "type": "module",
    "main": "./dist/lint/index.cjs",
    "module": "./dist/lint/index.mjs",
    "types": "./dist/lint/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/lint/index.mjs",
            "require": "./dist/lint/index.cjs",
            "types": "./dist/lint/index.d.ts"
        },
        "./git": {
            "import": "./dist/git/index.mjs",
            "require": "./dist/git/index.cjs",
            "types": "./dist/git/index.d.ts"
        },
        "./aivn": {
            "import": "./dist/aivn/index.mjs",
            "require": "./dist/aivn/index.cjs",
            "types": "./dist/aivn/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "bin": {
        "nut-lint": "./dist/lint/index.cjs",
        "nut-git": "./dist/git/index.cjs",
        "nut-aivn": "./dist/aivn/index.cjs"
    },
    "scripts": {
        "dev": "cross-env NODE_ENV=development rollup -c rollup.config.ts --watch --bundleConfigAsCjs --configPlugin typescript",
        "build": "cross-env NODE_ENV=production rollup -c rollup.config.ts --bundleConfigAsCjs --configPlugin typescript",
        "clean": "rimraf dist",
        "demo": "node demo/index.cjs",
        "rules:activate": "node .codebuddy/skills/specflow-rules-engine/scripts/sync-rules.cjs activate",
        "rules:deactivate": "node .codebuddy/skills/specflow-rules-engine/scripts/sync-rules.cjs deactivate",
        "rules:scan": "node .codebuddy/skills/specflow-rules-engine/scripts/sync-rules.cjs scan",
        "rules:activate-all": "node .codebuddy/skills/specflow-rules-engine/scripts/sync-rules.cjs activate-all",
        "rules:deactivate-all": "node .codebuddy/skills/specflow-rules-engine/scripts/sync-rules.cjs deactivate-all"
    },
    "dependencies": {
        "@rollup/pluginutils": "^5.1.0",
        "chokidar": "^3.5.3",
        "commander": "^12.1.0",
        "cross-spawn": "7.0.6",
        "fs-extra": "^11.3.2",
        "glob": "^10.3.3",
        "iconv-lite": "^0.6.3",
        "prettier": "^3.1.1",
        "eslint": "^8.56.0",
        "rimraf": "^5.0.5",
        "semver": "^7.6.2"
    },
    "devDependencies": {
        "@babel/core": "^7.24.3",
        "@babel/preset-env": "^7.24.3",
        "@babel/preset-typescript": "^7.24.1",
        "@rollup/plugin-alias": "^5.1.0",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.5",
        "@rollup/plugin-typescript": "^11.1.6",
        "@types/cross-spawn": "^6.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.10.6",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "cross-env": "10.1.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "prettier": "^3.1.1",
        "rollup": "^4.53.3",
        "rollup-plugin-delete": "^2.1.0",
        "rollup-plugin-dts": "^6.1.0",
        "ts-jest": "^29.4.5",
        "tslib": "2.8.1",
        "tsx": "4.21.0",
        "typescript": "^5.4.2"
    },
    "keywords": [
        "cli",
        "node-ultra",
        "code-execution",
        "format",
        "lint",
        "knowledge-base",
        "cross-platform",
        "tools",
        "automation",
        "ai-tools"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": ""
    }
}
