{
    "name": "flow",
    "description": "编排层模板：大工程全流程（需求→设计→开发→质检→部署）跨 skill 编排。与 anchor.config.json（单 skill 内部）用同一引擎，区别在每个 anchor 用 delegateSkill 委派一个子 skill，并用 memory 做跨任务决策记忆、onEscalate 做回滚。",
    "stateFile": ".specflow/flow-state.json",
    "logFile": ".specflow/flow-log.jsonl",
    "scratchDir": ".specflow/scratch",
    "scratchGcHours": 72,
    "maxAttempts": 5,
    "maxJumps": 3,
    "memory": {
        "localStore": ".specflow/memory/store.json",
        "mcp": true
    },
    "anchors": [
        {
            "id": "context",
            "name": "上下文准备",
            "brief": "读入决策记忆（项目事实、上次决策）+ 组装本轮上下文包。这是跨轮决策的入口：上个工程沉淀的结论在这里被内联进来，模型不需要重新探索。",
            "readsMemory": ["projectFacts", "lastDecisions"],
            "produces": [".specflow/context/context-pkg.json"],
            "allowedTools": ["read_file", "search_content", "code-explorer"],
            "verify": {
                "producesExist": true,
                "producesFresh": true
            }
        },
        {
            "id": "requirement",
            "name": "需求澄清",
            "brief": "委派 req-clarify 子 skill：基于 context-pkg 补齐需求漏洞、边界、数据流，产出 spec.json。",
            "delegateSkill": "req-clarify",
            "consumes": [],
            "produces": [".specflow/context/spec.json"],
            "emits": ["spec"],
            "verify": {
                "schema": {
                    "type": "object",
                    "required": ["requirement_spec"]
                },
                "producesExist": true,
                "producesFresh": true
            }
        },
        {
            "id": "design",
            "name": "技术设计",
            "brief": "委派 frontend-design 子 skill：基于 spec 产出 frontendPlan（组件拆分/路由/数据流/耦合分析）。设计不达标时回滚到 requirement 重新澄清。",
            "delegateSkill": "frontend-design",
            "consumes": ["spec"],
            "produces": [".specflow/context/frontend-plan.json"],
            "emits": ["frontendPlan"],
            "onEscalate": "requirement",
            "verify": {
                "schema": {
                    "type": "object",
                    "required": ["functionOwnership", "stateClassification", "moduleBoundary"]
                },
                "producesExist": true,
                "producesFresh": true
            }
        },
        {
            "id": "dev",
            "name": "代码生成",
            "brief": "委派 frontend-codegen 子 skill：按 frontendPlan 生成代码。大任务先 subtask-add 拆分逐个完成。引擎用 tsc/lint/build 的确定性结果证明 skill 真跑完。",
            "delegateSkill": "frontend-codegen",
            "consumes": ["frontendPlan"],
            "produces": ["src/**/*.ts", "src/**/*.tsx"],
            "maxAttempts": 8,
            "verify": {
                "lintFix": true,
                "lint": true,
                "tsc": true,
                "producesExist": true,
                "producesFresh": true
            }
        },
        {
            "id": "quality",
            "name": "质检门禁",
            "brief": "委派 code-quality-guard 子 skill：全量 lint + tsc 到 0 错误。不通过时回滚到 dev 重新修复。",
            "delegateSkill": "code-quality-guard",
            "onEscalate": "dev",
            "verify": {
                "lint": true,
                "tsc": true
            }
        },
        {
            "id": "deploy",
            "name": "部署与验证",
            "brief": "执行部署 + 冒烟测试，产出 deploy-report。完成后把本轮关键决策和部署结果回写决策记忆，供下个工程读取（跨轮决策闭环）。",
            "consumes": ["frontendPlan"],
            "writesMemory": ["lastDecisions", "deployResult"],
            "produces": [".specflow/context/deploy-report.json"],
            "allowedTools": ["execute_command", "read_file", "write_file"],
            "verify": {
                "producesExist": true,
                "producesFresh": true
            }
        }
    ]
}
