{
  "name": "web-ui-design",
  "description": "Web UI/交互设计 ADS harness — 需求→功能→布局→交互→线框图→容错→检测。融入 HCI 七定律/诺曼七阶段/目标导向/微交互/渐进披露/错误容错/信息层级理论。引擎 schema 校验完备性 + custom 客观项脚本 + review 6 项设计决策质量评审。",
  "scratchDir": ".specflow/scratch",
  "scratchGcHours": 72,
  "maxAttempts": 5,
  "anchors": [
    {
      "id": "ui-design",
      "name": "UI/交互设计（需求→线框图）",
      "brief": "7 Phase 流程（融入交互设计理论）：Phase0 需求读+目标导向(区分目标/任务/功能) → Phase1 功能思考(覆盖需求) → Phase2 信息架构+布局决策(五层模型结构层+费茨/希克/米勒定律+方案量化对比) → Phase3 交互设计(诺曼七阶段消除鸿沟+微交互四要素+渐进披露) → Phase4 线框图产出(ASCII+信息层级六大视觉手段) → Phase5 容错+状态覆盖(错误四策略+四态) → Phase6 设计检测(7项+交互理论校验)。产出 ui-design.json。引擎 schema 校验字段完备 + custom 跑客观项(导航≤9/方案≥2/线框图≥50字/四态覆盖/功能非空/目标非空/交互论证) + review 6 项设计决策质量主观评审。规则由 reads 内联。",
      "reads": [".codebuddy/skills/web-ui-design/RULE.mdc"],
      "produces": [".specflow/context/ui-design.json"],
      "emits": ["uiDesign"],
      "verify": {
        "schema": {
          "type": "object",
          "required": [
            "requirement",
            "functions",
            "informationArchitecture",
            "layoutDecisions",
            "interactionDesign",
            "wireframe",
            "stateCoverage"
          ],
          "properties": {
            "requirement": {
              "type": "object",
              "required": ["userGoal", "tasks", "functions"]
            },
            "layoutDecisions": {
              "type": "object",
              "required": ["options", "selected", "rationale"]
            },
            "wireframe": { "type": "string" },
            "stateCoverage": {
              "type": "object",
              "required": ["empty", "loading", "error", "success"]
            }
          }
        },
        "producesFresh": true,
        "custom": [
          "node .codebuddy/skills/web-ui-design/scripts/check-ui-objective.mjs --design .specflow/context/ui-design.json"
        ],
        "review": {
          "output": ".specflow/context/ui-review.json",
          "requireEvidence": true,
          "checklist": [
            {
              "id": "requirement-understanding",
              "rule": "需求理解：明确用户目标（非功能清单），区分目标/任务/功能（目标导向设计·About Face）",
              "mode": "model"
            },
            {
              "id": "function-completeness",
              "rule": "功能完整：覆盖需求所有功能点，无遗漏无冗余（五层模型·范围层）",
              "mode": "model"
            },
            {
              "id": "layout-decision",
              "rule": "布局决策：≥2方案量化对比选优，符合费茨(触达距离)/希克(选项数)/米勒(7±2)定律",
              "mode": "model"
            },
            {
              "id": "interaction-design",
              "rule": "交互设计：消除执行/评估鸿沟（诺曼七阶段），微交互有反馈（四要素），渐进披露适度",
              "mode": "model"
            },
            {
              "id": "information-hierarchy",
              "rule": "信息层级：P0-P3 分级清晰，六大视觉手段(尺寸/色彩/间距/权重/位置/阴影)建立优先级",
              "mode": "model"
            },
            {
              "id": "error-robustness",
              "rule": "容错覆盖：预防/捕获/告知/恢复四策略 + 空/加载/错误/成功四态全覆盖（错误容错设计）",
              "mode": "model"
            }
          ]
        }
      }
    }
  ]
}
